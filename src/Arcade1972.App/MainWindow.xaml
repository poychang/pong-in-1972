<Window
    x:Class="Arcade1972.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="1972 Arcade">
    <Grid Background="{StaticResource GameBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Background="#101010"
            Loaded="AppTitleBar_Loaded"
            SizeChanged="AppTitleBar_SizeChanged">
            <TextBlock
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                FontFamily="Consolas"
                FontSize="12"
                Foreground="{StaticResource GameForegroundBrush}"
                Text="1972 ARCADE" />
            <StackPanel
                x:Name="TitleBarActions"
                Margin="0,4,144,4"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    x:Name="InformationButton"
                    Padding="10,0"
                    AutomationProperties.Name="Show controls"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="InformationButton_Click"
                    Foreground="{StaticResource GameForegroundBrush}"
                    ToolTipService.ToolTip="Controls">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" />
                </Button>
                <Button
                    x:Name="FullScreenButton"
                    Padding="10,0"
                    AutomationProperties.Name="Toggle full screen"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="FullScreenButton_Click"
                    Foreground="{StaticResource GameForegroundBrush}"
                    ToolTipService.ToolTip="Full screen">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE740;" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid
            x:Name="GameRoot"
            Grid.Row="1"
            PointerPressed="GameRoot_PointerPressed">
            <Border Margin="32" BorderBrush="{StaticResource GameForegroundBrush}" BorderThickness="2">
                <Canvas x:Name="GameCanvas" SizeChanged="GameCanvas_SizeChanged">
                    <Rectangle x:Name="CenterLine" Fill="{StaticResource GameForegroundBrush}" />
                    <Rectangle x:Name="LeftPaddle" Fill="{StaticResource GameForegroundBrush}" />
                    <Rectangle x:Name="RightPaddle" Fill="{StaticResource GameForegroundBrush}" />
                    <Rectangle x:Name="Ball" Fill="{StaticResource GameForegroundBrush}" />
                    <TextBlock
                        x:Name="LeftScore"
                        FontFamily="Consolas"
                        FontSize="48"
                        Foreground="{StaticResource GameForegroundBrush}"
                        Text="0" />
                    <TextBlock
                        x:Name="RightScore"
                        FontFamily="Consolas"
                        FontSize="48"
                        Foreground="{StaticResource GameForegroundBrush}"
                        Text="0" />
                </Canvas>
            </Border>

            <Grid x:Name="MenuOverlay" Background="#E6050505">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18">
                    <TextBlock
                        x:Name="MenuHeading"
                        HorizontalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="32"
                        Foreground="{StaticResource GameForegroundBrush}"
                        Text="1972 ARCADE" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="14"
                        Foreground="{StaticResource GameForegroundBrush}"
                        Text="W / S        UP / DOWN" />
                    <Button
                        MinWidth="180"
                        Padding="24,12"
                        HorizontalAlignment="Center"
                        AutomationProperties.Name="Start one player match"
                        Background="#F4F1E8"
                        BorderThickness="0"
                        Click="StartOnePlayerButton_Click"
                        CornerRadius="0"
                        FontFamily="Consolas"
                        Foreground="#050505"
                        Content="ONE PLAYER" />
                    <Button
                        x:Name="StartButton"
                        MinWidth="180"
                        Padding="24,12"
                        HorizontalAlignment="Center"
                        AutomationProperties.Name="Start local two player match"
                        Background="#F4F1E8"
                        BorderThickness="0"
                        Click="StartButton_Click"
                        CornerRadius="0"
                        FontFamily="Consolas"
                        Foreground="#050505"
                        Content="TWO PLAYERS" />
                </StackPanel>
            </Grid>

            <Button
                x:Name="InputSink"
                Width="1"
                Height="1"
                Opacity="0"
                IsTabStop="True"
                KeyDown="InputSink_KeyDown"
                KeyUp="InputSink_KeyUp" />
        </Grid>

        <Grid
            x:Name="InformationOverlay"
            Grid.Row="1"
            Canvas.ZIndex="20"
            Background="#F2050505"
            KeyDown="InformationOverlay_KeyDown"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button
                x:Name="CloseInformationButton"
                Grid.Row="0"
                Margin="0,16,20,0"
                Padding="12"
                HorizontalAlignment="Right"
                AutomationProperties.Name="Close controls"
                Background="Transparent"
                BorderThickness="0"
                Click="CloseInformationButton_Click"
                Foreground="{StaticResource GameForegroundBrush}"
                ToolTipService.ToolTip="Close">
                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE711;" />
            </Button>

            <StackPanel
                Grid.Row="1"
                MaxWidth="640"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="28">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontFamily="Consolas"
                    FontSize="30"
                    Foreground="{StaticResource GameForegroundBrush}"
                    Text="CONTROLS" />

                <Grid ColumnSpacing="64">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="240" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="14">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="18"
                            Foreground="{StaticResource GameForegroundBrush}"
                            Text="PLAYER 1" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="16"
                            Foreground="{StaticResource GameForegroundBrush}"
                            Text="W   MOVE UP" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="16"
                            Foreground="{StaticResource GameForegroundBrush}"
                            Text="S   MOVE DOWN" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="14">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="18"
                            Foreground="{StaticResource GameForegroundBrush}"
                            Text="PLAYER 2" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="16"
                            Foreground="{StaticResource GameForegroundBrush}"
                            Text="UP ARROW     MOVE UP" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="16"
                            Foreground="{StaticResource GameForegroundBrush}"
                            Text="DOWN ARROW   MOVE DOWN" />
                    </StackPanel>
                </Grid>

                <TextBlock
                    HorizontalAlignment="Center"
                    FontFamily="Consolas"
                    FontSize="13"
                    Foreground="#B8B8B8"
                    Text="ONE PLAYER MODE USES PLAYER 1 CONTROLS"
                    TextAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>